# Fim de linha LF em todo texto, inclusive em checkout no Windows.
# Evita que o Git converta para CRLF e quebre comparação de arquivo.
* text=auto eol=lf

# Atalhos do Windows precisam de CRLF, senão o cmd.exe erra nos blocos if.
*.bat text eol=crlf

*.png binary
*.jpg binary
*.pdf binary
*.xlsx binary
*.webm binary
*.crt binary
*.key binary

# Ícones e pacotes de aplicativo são binários.
*.icns binary
*.ico binary
